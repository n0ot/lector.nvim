#!/bin/sh
set -eu

test_state=$(mktemp -d "${TMPDIR:-/tmp}/lector.nvim-tests.XXXXXX")
trap 'rm -rf "$test_state"' EXIT HUP INT TERM
nvim_bin=${LECTOR_NVIM:-nvim}

for suite in completion editing command_output policy transient_output semantics reload; do
  XDG_STATE_HOME="$test_state" "$nvim_bin" --headless -u NONE -i NONE -n \
    -l "tests/$suite.lua"
done

LECTOR_NVIM="$nvim_bin" PYTHONDONTWRITEBYTECODE=1 python3 tests/pty.py
LECTOR_NVIM="$nvim_bin" PYTHONDONTWRITEBYTECODE=1 python3 tests/lsp.py
